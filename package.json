{
  "name": "@beforeyoubid/design-system",
  "version": "2.0.0",
  "description": "BYB design system \u2014 Tailwind CSS v4 + shadcn/ui (BaseUI) pattern components",
  "author": "Before You Buy",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "globals.css",
    "shadcn.css",
    "utilities.css",
    "migrate/index.mjs",
    "migrate/rules.mjs"
  ],
  "bin": {
    "design-system-migrate": "migrate/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons-lucide.d.ts",
      "import": "./dist/icons-lucide.mjs",
      "require": "./dist/icons-lucide.js"
    },
    "./globals.css": "./globals.css",
    "./utilities.css": "./utilities.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsup",
    "build-and-publish": "pnpm run build && npm publish --access public",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "type-check:stories": "tsc --noEmit -p tsconfig.stories.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-tokens": "node scripts/generate-tokens.mjs --check",
    "generate-tokens": "node scripts/generate-tokens.mjs",
    "sync-shadcn-css": "node scripts/sync-shadcn-css.mjs",
    "check-shadcn-css": "node scripts/sync-shadcn-css.mjs --check",
    "test": "jest",
    "test:migrate": "node --test migrate/rules.test.mjs",
    "test:cn": "node --experimental-strip-types --no-warnings --test scripts/tests/cn.test.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^4",
    "eslint-plugin-storybook": "^10.3.6",
    "next": "^14",
    "playwright": "^1.59.1",
    "shadcn": "4.22.1",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.2.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.47.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.11.1",
    "recharts": "3.8.0",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beforeyoubid/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/beforeyoubid/design-system/issues"
  },
  "homepage": "https://github.com/beforeyoubid/design-system#readme"
}
