{
  "name": "@beforeyoubid/design-system-monorepo",
  "private": true,
  "description": "BYB design-system platform monorepo — packages/design-system is the published package; apps/* are private demo surfaces.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @beforeyoubid/design-system build",
    "dev": "pnpm --filter @beforeyoubid/design-system dev",
    "lint": "pnpm --filter @beforeyoubid/design-system lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm --filter @beforeyoubid/design-system test",
    "build-tokens": "pnpm --filter @beforeyoubid/design-system build-tokens",
    "check-tokens": "pnpm --filter @beforeyoubid/design-system check-tokens",
    "storybook": "pnpm --filter @beforeyoubid/design-system storybook",
    "build-storybook": "pnpm --filter @beforeyoubid/design-system build-storybook",
    "demo": "pnpm --filter demo dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  }
}
