{
  "name": "@beforeyoubid/design-system",
  "version": "1.1.3",
  "description": "BYB design system — Tailwind CSS v4 + shadcn/ui (BaseUI) pattern components",
  "author": "Before You Buy",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "globals.css",
    "utilities.css",
    "registry.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.mjs",
      "require": "./dist/chart.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.mjs",
      "require": "./dist/calendar.js"
    },
    "./carousel": {
      "types": "./dist/carousel.d.ts",
      "import": "./dist/carousel.mjs",
      "require": "./dist/carousel.js"
    },
    "./globals.css": "./globals.css",
    "./utilities.css": "./utilities.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build-tokens": "node scripts/build-tokens.js",
    "build": "pnpm run clean && node scripts/build-tokens.js && tsup",
    "build-and-publish": "pnpm run build && npm publish --access public",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-tokens": "node scripts/build-tokens.js --check",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:watch": "vitest --project unit"
  },
  "peerDependencies": {
    "embla-carousel-react": ">=8.6",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "react-day-picker": ">=9",
    "recharts": ">=3.8",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "embla-carousel-react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^8",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^4",
    "eslint-plugin-storybook": "^10.3.6",
    "next": "^14",
    "playwright": "^1.59.1",
    "react-day-picker": "^9.0.0",
    "recharts": "3.8.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react-resizable-panels": "^4.11.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2",
    "vaul": "^1.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beforeyoubid/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/beforeyoubid/design-system/issues"
  },
  "homepage": "https://github.com/beforeyoubid/design-system#readme"
}
